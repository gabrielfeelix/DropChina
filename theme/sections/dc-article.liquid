{%- comment -%} DropChina — template de artigo (layout editorial de leitura). {%- endcomment -%}
{%- assign words = article.content | strip_html | split: ' ' | size -%}
{%- assign read_min = words | divided_by: 200 | at_least: 1 -%}

{{ article | structured_data }}

<article class="dc-article">
  <header class="dc-article__wrap dc-article__head">
    <a href="{{ blog.url }}" class="dc-article__back">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
      {{ blog.title | default: 'Blog' }}
    </a>
    {%- if article.tags.size > 0 -%}
      <span class="dc-article__eyebrow">{{ article.tags.first }}</span>
    {%- endif -%}
    <h1 class="dc-article__title">{{ article.title }}</h1>
    <div class="dc-article__meta">
      <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%d de %B de %Y' }}</time>
      <span class="dc-article__dot" aria-hidden="true">•</span>
      <span>{{ read_min }} min de leitura</span>
      {%- if article.author != blank -%}
        <span class="dc-article__dot" aria-hidden="true">•</span>
        <span>por {{ article.author }}</span>
      {%- endif -%}
    </div>
  </header>

  {%- if article.image -%}
    <figure class="dc-article__hero">
      <img
        src="{{ article.image | image_url: width: 1400 }}"
        srcset="{{ article.image | image_url: width: 700 }} 700w, {{ article.image | image_url: width: 1000 }} 1000w, {{ article.image | image_url: width: 1400 }} 1400w"
        sizes="(max-width: 1000px) 100vw, 1000px"
        alt="{{ article.image.alt | default: article.title | escape }}"
        width="1400"
        height="{{ 1400 | divided_by: article.image.aspect_ratio | round }}"
        loading="eager"
        fetchpriority="high"
      >
    </figure>
  {%- endif -%}

  <div class="dc-article__wrap">
    {%- if article.excerpt != blank -%}
      <p class="dc-article__lead">{{ article.excerpt | strip_html }}</p>
    {%- endif -%}

    <div class="dc-article__content rte">
      {{ article.content }}
    </div>

    <div class="dc-article__share">
      <span class="dc-article__share-label">Compartilhar</span>
      <a class="dc-article__share-btn" href="https://wa.me/?text={{ article.title | url_encode }}%20{{ request.origin | append: article.url | url_encode }}" target="_blank" rel="noopener" aria-label="Compartilhar no WhatsApp">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.5 15.2L2 22l4.9-1.4A10 10 0 1 0 12 2Zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .1-1.7-.1-.4-.1-.9-.3-1.6-.6-2.8-1.2-4.6-4-4.7-4.2-.2-.2-1.2-1.5-1.2-2.9 0-1.3.7-2 1-2.3.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.3 0 .5l-.4.6c-.2.2-.3.4-.1.7.2.3.8 1.3 1.7 2 .9.7 1.5.9 1.8 1.1.2.1.4.1.6-.1l.7-.9c.2-.2.4-.2.6-.1l1.9.9c.2.1.4.2.4.3.1.2.1.9-.1 1.5Z"/></svg>
        WhatsApp
      </a>
      <button class="dc-article__share-btn" type="button" data-dc-copy-link>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-1 1"/><path d="M14 11a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l1-1"/></svg>
        Copiar link
      </button>
    </div>

    <aside class="dc-article__help">
      <div class="dc-article__help-text">
        <b>Ficou na dúvida sobre qual produto serve?</b>
        <p>Chama a gente no WhatsApp com o modelo da sua impressora. A gente confirma o produto certo antes de você comprar.</p>
      </div>
      <a class="dc-article__help-cta" href="https://wa.me/5541995342751" target="_blank" rel="noopener">Falar no WhatsApp</a>
    </aside>
  </div>

  {%- assign related = blog.articles | where_exp: 'a', 'a.id != article.id' -%}
  {%- if related.size > 0 -%}
    <div class="dc-article__wrap dc-article__related-wrap">
      <h2 class="dc-article__related-title">Leia também</h2>
      <div class="dc-article__related">
        {%- for a in related limit: 3 -%}
          <a href="{{ a.url }}" class="dc-related-card">
            <div class="dc-related-card__img">
              {%- if a.image -%}
                <img src="{{ a.image | image_url: width: 520 }}" alt="{{ a.title | escape }}" loading="lazy" width="520" height="300">
              {%- else -%}
                <div class="dc-related-card__ph"></div>
              {%- endif -%}
            </div>
            <div class="dc-related-card__body">
              {%- if a.tags.size > 0 -%}<span class="dc-related-card__tag">{{ a.tags.first }}</span>{%- endif -%}
              <h3>{{ a.title }}</h3>
            </div>
          </a>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</article>

<script>
  (function () {
    var b = document.querySelector('[data-dc-copy-link]');
    if (b) b.addEventListener('click', function () {
      if (navigator.clipboard) navigator.clipboard.writeText(location.href).then(function () {
        var t = b.querySelector('svg'); var prev = b.childNodes;
        b.setAttribute('data-copied', '1');
        var label = b.lastChild;
        b.lastChild.textContent = ' Copiado!';
        setTimeout(function () { b.lastChild.textContent = ' Copiar link'; b.removeAttribute('data-copied'); }, 1600);
      });
    });
  })();
</script>

{% stylesheet %}
  .dc-article { padding: 40px 0 72px; color: #1a1d20; }
  .dc-article__wrap { max-width: 720px; margin-inline: auto; padding-inline: 24px; }

  .dc-article__back {
    display: inline-flex; align-items: center; gap: 6px;
    color: #6b7280; font-size: 14px; font-weight: 600; text-decoration: none;
    margin-bottom: 22px; transition: color 0.15s;
  }
  .dc-article__back:hover { color: #0d1115; }
  .dc-article__eyebrow {
    display: inline-block; font-size: 12px; font-weight: 700; letter-spacing: 0.1em;
    text-transform: uppercase; color: #0f4fa8; margin-bottom: 14px;
  }
  .dc-article__title {
    font-family: "Bricolage Grotesque", "Manrope", sans-serif;
    font-size: clamp(2rem, 4.5vw, 2.85rem); line-height: 1.08; letter-spacing: -0.025em;
    font-weight: 700; color: #0d1115; margin: 0 0 18px;
  }
  .dc-article__meta {
    display: flex; align-items: center; flex-wrap: wrap; gap: 8px;
    color: #6b7280; font-size: 14px;
  }
  .dc-article__dot { color: #c8cdd4; }

  .dc-article__hero {
    max-width: 1000px; margin: 34px auto 8px; padding-inline: 24px;
  }
  .dc-article__hero img {
    width: 100%; height: auto; border-radius: 20px; display: block;
    background: #f4f5f7;
  }

  .dc-article__lead {
    font-size: 20px; line-height: 1.6; color: #4a5158; font-weight: 500;
    margin: 34px 0 8px;
  }

  /* Corpo do artigo (rich text) */
  .dc-article__content { font-size: 18px; line-height: 1.78; color: #2a3038; }
  .dc-article__content > *:first-child { margin-top: 0; }
  .dc-article__content p { margin: 0 0 22px; }
  .dc-article__content h2 {
    font-family: "Bricolage Grotesque", "Manrope", sans-serif;
    font-size: 27px; line-height: 1.2; letter-spacing: -0.02em; font-weight: 700;
    color: #0d1115; margin: 46px 0 16px; scroll-margin-top: 90px;
  }
  .dc-article__content h3 {
    font-size: 20px; font-weight: 700; color: #0d1115; margin: 34px 0 12px;
  }
  .dc-article__content a { color: #0f4fa8; text-decoration: underline; text-underline-offset: 2px; }
  .dc-article__content a:hover { color: #0d1115; }
  .dc-article__content ul, .dc-article__content ol { margin: 0 0 22px; padding-left: 24px; }
  .dc-article__content li { margin-bottom: 9px; }
  .dc-article__content ul li::marker { color: #0f4fa8; }
  .dc-article__content img { max-width: 100%; height: auto; border-radius: 14px; margin: 14px 0; }
  .dc-article__content blockquote {
    margin: 28px 0; padding: 6px 22px; border-left: 4px solid #0e8aa5;
    color: #0d1115; font-size: 19px; font-style: italic;
  }
  .dc-article__content hr { border: 0; border-top: 1px solid #ececef; margin: 40px 0; }
  .dc-article__content strong { color: #0d1115; }
  .dc-article__content table { width: 100%; border-collapse: collapse; margin: 0 0 22px; font-size: 15.5px; }
  .dc-article__content th, .dc-article__content td { border: 1px solid #ececef; padding: 10px 12px; text-align: left; }
  .dc-article__content th { background: #f4f5f7; font-weight: 700; color: #0d1115; }

  /* Share */
  .dc-article__share {
    display: flex; align-items: center; flex-wrap: wrap; gap: 10px;
    margin: 40px 0 0; padding-top: 26px; border-top: 1px solid #ececef;
  }
  .dc-article__share-label { font-size: 14px; font-weight: 700; color: #6b7280; margin-right: 4px; }
  .dc-article__share-btn {
    display: inline-flex; align-items: center; gap: 7px;
    height: 40px; padding: 0 16px; border-radius: 999px;
    border: 1px solid #d9dade; background: #ffffff; color: #0d1115;
    font-family: inherit; font-size: 13.5px; font-weight: 600; cursor: pointer; text-decoration: none;
    transition: background 0.15s, border-color 0.15s;
  }
  .dc-article__share-btn:hover { background: #f4f5f7; border-color: #c8cdd4; }

  /* Box de ajuda */
  .dc-article__help {
    margin: 34px 0 0; padding: 26px 28px; border-radius: 20px;
    background: #0d1115; color: #ffffff;
    display: flex; align-items: center; justify-content: space-between; gap: 20px; flex-wrap: wrap;
  }
  .dc-article__help-text b { font-size: 16.5px; display: block; margin-bottom: 4px; }
  .dc-article__help-text p { margin: 0; color: rgba(255,255,255,0.7); font-size: 14px; line-height: 1.5; max-width: 46ch; }
  .dc-article__help-cta {
    flex: none; display: inline-flex; align-items: center; height: 46px; padding: 0 22px;
    border-radius: 999px; background: #22c55e; color: #04340f;
    font-weight: 700; font-size: 14.5px; text-decoration: none; white-space: nowrap;
    transition: transform 0.15s, background 0.15s;
  }
  .dc-article__help-cta:hover { background: #1fb455; transform: translateY(-1px); }

  /* Leia também */
  .dc-article__related-wrap { margin-top: 56px; padding-top: 40px; border-top: 1px solid #ececef; max-width: 1000px; }
  .dc-article__related-title {
    font-family: "Bricolage Grotesque", "Manrope", sans-serif;
    font-size: 24px; font-weight: 700; letter-spacing: -0.02em; color: #0d1115; margin: 0 0 22px;
  }
  .dc-article__related { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .dc-related-card {
    display: flex; flex-direction: column; border: 1px solid #ececef; border-radius: 16px;
    overflow: hidden; text-decoration: none; background: #fff; transition: transform 0.16s, box-shadow 0.16s;
  }
  .dc-related-card:hover { transform: translateY(-3px); box-shadow: 0 18px 40px -18px rgba(20,22,24,0.22); }
  .dc-related-card__img { aspect-ratio: 16/10; background: #f4f5f7; overflow: hidden; }
  .dc-related-card__img img { width: 100%; height: 100%; object-fit: cover; }
  .dc-related-card__ph { width: 100%; height: 100%; background: linear-gradient(135deg,#eef1f5,#dfe4ea); }
  .dc-related-card__body { padding: 16px 18px 20px; }
  .dc-related-card__tag { font-size: 11px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #0f4fa8; }
  .dc-related-card__body h3 { font-size: 16px; line-height: 1.3; font-weight: 700; color: #0d1115; margin: 8px 0 0; }

  @media (max-width: 820px) {
    .dc-article__related { grid-template-columns: 1fr; }
    .dc-article__help { flex-direction: column; align-items: flex-start; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "DropChina Article",
  "tag": "section",
  "class": "section-dc-article",
  "settings": [],
  "presets": [{ "name": "DropChina Article" }]
}
{% endschema %}
