{%- comment -%}
  DC ISD Categories — grade de categorias da Automação (cards escuros, DNA ISD).
  Cada card = um bloco "Categoria" (eyebrow, título, descrição, ícone/imagem, link, selo).
  Totalmente editável no Editor de Tema.
{%- endcomment -%}

<section class="dc-isd-cats" style="padding-block: {{ section.settings.padding_top | default: 80 }}px {{ section.settings.padding_bottom | default: 80 }}px;" id="{{ section.settings.anchor_id | default: 'isd-categorias' | escape }}">
  <span class="dc-isd-cats__glow" aria-hidden="true"></span>
  <div class="dc-isd-cats__container">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <header class="dc-isd-cats__head">
        {%- if section.settings.eyebrow != blank -%}<span class="dc-isd-cats__eyebrow">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="dc-isd-cats__title">{{ section.settings.heading | escape }}</h2>{%- endif -%}
        {%- if section.settings.subheading != blank -%}<p class="dc-isd-cats__sub">{{ section.settings.subheading | escape }}</p>{%- endif -%}
      </header>
    {%- endif -%}

    <div class="dc-isd-cats__grid dc-isd-cats__grid--{{ section.settings.columns | default: 4 }}">
      {%- for block in section.blocks -%}
        {%- assign lnk = block.settings.cta_link | default: '#' -%}
        <a href="{{ lnk }}" class="dc-isd-cat" {{ block.shopify_attributes }}{% if lnk contains 'wa.me' or lnk contains 'http' %} target="_blank" rel="noopener"{% endif %}>
          {%- if block.settings.badge != blank -%}<span class="dc-isd-cat__badge">{{ block.settings.badge | escape }}</span>{%- endif -%}
          <span class="dc-isd-cat__art">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 560 | image_tag: loading: 'lazy', class: 'dc-isd-cat__img', alt: block.settings.title | default: '', widths: '280, 420, 560', sizes: '(max-width: 760px) 90vw, 300px' }}
            {%- else -%}
              <span class="dc-isd-cat__icon">
                {%- case block.settings.icon -%}
                  {%- when 'signage' -%}<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
                  {%- when 'camera' -%}<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="m17 8 4-2v12l-4-2"/><rect x="1" y="6" width="16" height="12" rx="2"/></svg>
                  {%- when 'printer' -%}<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9V3h12v6"/><rect x="3" y="9" width="18" height="9" rx="2"/><rect x="6" y="14" width="12" height="7" rx="1"/></svg>
                  {%- when 'totem' -%}<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="2" width="12" height="16" rx="2"/><path d="M9 6h6M9 10h4M12 18v4M9 22h6"/></svg>
                  {%- when 'screen' -%}<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="13" rx="2"/><path d="M12 8.5 15 11l-3 2.5z" fill="currentColor"/></svg>
                  {%- else -%}<svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2 13.5 9 21 10.5 13.5 12 12 19 10.5 12 3 10.5 10.5 9 12 2Z"/></svg>
                {%- endcase -%}
              </span>
            {%- endif -%}
          </span>
          <span class="dc-isd-cat__body">
            {%- if block.settings.eyebrow != blank -%}<span class="dc-isd-cat__eyebrow">{{ block.settings.eyebrow | escape }}</span>{%- endif -%}
            <span class="dc-isd-cat__name">{{ block.settings.title | escape }}</span>
            {%- if block.settings.description != blank -%}<span class="dc-isd-cat__desc">{{ block.settings.description | escape }}</span>{%- endif -%}
            <span class="dc-isd-cat__cta">
              {{ block.settings.cta_label | default: 'Saiba mais' | escape }}
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14"/><path d="m13 5 7 7-7 7"/></svg>
            </span>
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .dc-isd-cats { position: relative; overflow: hidden; background: #070a0e; color: #eef2f7; isolation: isolate; }
  .dc-isd-cats__glow {
    position: absolute; z-index: 0; pointer-events: none;
    top: -120px; right: -80px; width: 520px; height: 360px; border-radius: 50%;
    background: radial-gradient(circle, rgba(58,160,255,0.14), transparent 68%); filter: blur(50px);
  }
  .dc-isd-cats__container { position: relative; z-index: 1; max-width: 1320px; margin: 0 auto; padding-inline: 28px; }
  .dc-isd-cats__head { text-align: center; max-width: 720px; margin: 0 auto 40px; }
  .dc-isd-cats__eyebrow { display: inline-block; font-size: 12.5px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: #6ea8e6; margin-bottom: 14px; }
  .dc-isd-cats__title { font-family: "Bricolage Grotesque", "Manrope", sans-serif; font-weight: 800; font-size: clamp(28px, 4vw, 44px); line-height: 1.05; letter-spacing: -0.03em; color: #fff; margin: 0 0 12px; }
  .dc-isd-cats__sub { font-size: 16px; color: #aab6c4; line-height: 1.55; margin: 0; }

  .dc-isd-cats__grid { display: grid; gap: 20px; grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .dc-isd-cats__grid--2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .dc-isd-cats__grid--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  @media (max-width: 1080px) { .dc-isd-cats__grid, .dc-isd-cats__grid--3, .dc-isd-cats__grid--4 { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .dc-isd-cats__grid { grid-template-columns: 1fr; } }

  .dc-isd-cat {
    position: relative; display: flex; flex-direction: column; gap: 18px;
    padding: 26px 24px 24px; border-radius: 22px; text-decoration: none;
    background: linear-gradient(180deg, rgba(255,255,255,0.05), rgba(255,255,255,0.02));
    border: 1px solid rgba(255,255,255,0.08); overflow: hidden;
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.3s ease;
  }
  .dc-isd-cat::after {
    content: ""; position: absolute; left: 0; right: 0; top: 0; height: 2px;
    background: linear-gradient(90deg, transparent, #3aa0ff, transparent);
    opacity: 0; transition: opacity 0.3s ease;
  }
  .dc-isd-cat:hover { transform: translateY(-4px); border-color: rgba(58,160,255,0.35); box-shadow: 0 26px 60px -30px rgba(58,160,255,0.5); }
  .dc-isd-cat:hover::after { opacity: 1; }

  .dc-isd-cat__badge {
    position: absolute; top: 16px; right: 16px; z-index: 2;
    background: rgba(58,160,255,0.16); color: #6ea8e6; border: 1px solid rgba(58,160,255,0.35);
    font-size: 10.5px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; padding: 4px 9px; border-radius: 999px;
  }
  .dc-isd-cat__art { display: block; }
  .dc-isd-cat__icon {
    display: inline-flex; align-items: center; justify-content: center;
    width: 54px; height: 54px; border-radius: 15px; color: #6ea8e6;
    background: radial-gradient(120% 120% at 30% 20%, rgba(58,160,255,0.22), rgba(58,160,255,0.06));
    border: 1px solid rgba(58,160,255,0.25);
  }
  .dc-isd-cat__img { width: 100%; height: 150px; object-fit: cover; border-radius: 14px; display: block; }

  .dc-isd-cat__body { display: flex; flex-direction: column; flex: 1; }
  .dc-isd-cat__eyebrow { font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: #6ea8e6; margin-bottom: 8px; }
  .dc-isd-cat__name { font-family: "Bricolage Grotesque", "Manrope", sans-serif; font-size: 21px; font-weight: 700; letter-spacing: -0.02em; color: #fff; margin-bottom: 9px; line-height: 1.15; }
  .dc-isd-cat__desc { font-size: 13.5px; color: #aab6c4; line-height: 1.55; margin-bottom: 16px; }
  .dc-isd-cat__cta { margin-top: auto; display: inline-flex; align-items: center; gap: 7px; font-size: 13.5px; font-weight: 700; color: #eef2f7; transition: gap 0.18s ease, color 0.18s ease; }
  .dc-isd-cat:hover .dc-isd-cat__cta { color: #6ea8e6; gap: 11px; }

  @media (prefers-reduced-motion: reduce) { .dc-isd-cat, .dc-isd-cat__cta { transition: none; } }
{% endstylesheet %}

{% schema %}
{
  "name": "DC ISD Categorias",
  "tag": "section",
  "class": "section-dc-isd-categories",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Linha completa ISD" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Tecnologia para cada ponto de contato." },
    { "type": "textarea", "id": "subheading", "label": "Subtítulo", "default": "Câmeras, totens, telas e impressão profissional — tudo com a robustez e o design da ISD Tech." },
    { "type": "select", "id": "columns", "label": "Colunas (desktop)", "default": "4", "options": [
      { "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" }
    ] },
    { "type": "text", "id": "anchor_id", "label": "ID de âncora", "default": "isd-categorias" },
    { "type": "header", "content": "Espaçamento" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 40, "max": 200, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 40, "max": 200, "step": 4, "unit": "px", "default": 80 }
  ],
  "blocks": [
    {
      "type": "categoria",
      "name": "Categoria",
      "settings": [
        { "type": "text", "id": "eyebrow", "label": "Eyebrow (ex: Reuniões em alta definição)" },
        { "type": "text", "id": "title", "label": "Título", "default": "Categoria" },
        { "type": "textarea", "id": "description", "label": "Descrição" },
        { "type": "select", "id": "icon", "label": "Ícone (se não usar imagem)", "default": "totem", "options": [
          { "value": "signage", "label": "Digital Signage" },
          { "value": "camera", "label": "Câmera" },
          { "value": "printer", "label": "Impressora" },
          { "value": "totem", "label": "Totem" },
          { "value": "screen", "label": "Tela interativa" }
        ] },
        { "type": "image_picker", "id": "image", "label": "Imagem (opcional, sobrepõe o ícone)" },
        { "type": "text", "id": "cta_label", "label": "Texto do link", "default": "Saiba mais" },
        { "type": "url", "id": "cta_link", "label": "Link", "info": "Pode ser âncora (#isd-produtos), coleção, página ou WhatsApp." },
        { "type": "text", "id": "badge", "label": "Selo (ex: Novo, Em breve)" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    { "name": "DC ISD Categorias" }
  ]
}
{% endschema %}
