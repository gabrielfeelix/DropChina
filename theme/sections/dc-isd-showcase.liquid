{%- comment -%}
  DC ISD Showcase — vitrine interativa de produtos da Automação (DNA ISD).
  Configurável: cada card é um bloco "Produto" (escolhe o produto + eyebrow + 3 specs).
  Sem blocos, cai numa coleção (fallback), então a página nunca fica vazia.
{%- endcomment -%}

{%- liquid
  assign product_blocks = section.blocks | where: 'type', 'produto'
  assign col = section.settings.collection
  if col == blank
    assign col = collections[section.settings.collection_handle]
  endif
  assign max_products = section.settings.max_products | default: 6

  assign use_blocks = false
  if product_blocks.size > 0
    assign use_blocks = true
  endif
-%}

<section
  class="dc-isd-show"
  style="padding-block: {{ section.settings.padding_top | default: 80 }}px {{ section.settings.padding_bottom | default: 88 }}px;"
  id="{{ section.settings.anchor_id | default: 'isd-produtos' | escape }}"
  data-dc-isd-show
>
  <span class="dc-isd-show__glow" aria-hidden="true"></span>
  <div class="dc-isd-show__container">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <header class="dc-isd-show__head">
        {%- if section.settings.eyebrow != blank -%}
          <span class="dc-isd-show__eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="dc-isd-show__title">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="dc-isd-show__sub">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </header>
    {%- endif -%}

    {%- comment -%} 1) tenta os blocos de produto; 2) se nenhum resolveu, cai na coleção {%- endcomment -%}
    {%- capture cards_html -%}
      {%- if use_blocks -%}
        {%- for block in product_blocks -%}
          {%- assign p = block.settings.product -%}
          {%- if p != blank -%}
            {%- render 'dc-isd-card',
                product: p,
                eyebrow: block.settings.eyebrow,
                title: block.settings.title,
                spec1: block.settings.spec1,
                spec2: block.settings.spec2,
                spec3: block.settings.spec3,
                badge: block.settings.badge,
                cta_label: section.settings.cta_label,
                shopify_attributes: block.shopify_attributes -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    {%- endcapture -%}
    {%- assign cards_stripped = cards_html | strip -%}
    {%- if cards_stripped == blank and col != blank and col.products_count > 0 -%}
      {%- capture cards_html -%}
        {%- for p in col.products limit: max_products -%}
          {%- render 'dc-isd-card',
              product: p,
              eyebrow: p.type,
              cta_label: section.settings.cta_label -%}
        {%- endfor -%}
      {%- endcapture -%}
      {%- assign cards_stripped = cards_html | strip -%}
    {%- endif -%}

    <div class="dc-isd-show__grid dc-isd-show__grid--{{ section.settings.columns | default: 3 }}">
      {%- if cards_stripped != blank -%}
        {{ cards_html }}
      {%- else -%}
        <p class="dc-isd-show__empty">Configure os produtos desta vitrine no Editor de Tema (bloco “Produto”) ou selecione uma coleção.</p>
      {%- endif -%}
    </div>

    {%- if section.settings.foot_cta_label != blank -%}
      <div class="dc-isd-show__foot">
        <a href="{{ section.settings.foot_cta_link | default: '#' }}" class="dc-isd-show__foot-btn">
          {{ section.settings.foot_cta_label | escape }}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14"/><path d="m13 5 7 7-7 7"/></svg>
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .dc-isd-show {
    position: relative;
    overflow: hidden;
    background: linear-gradient(180deg, #070a0e 0%, #0b1017 100%);
    color: #eef2f7;
    isolation: isolate;
  }
  .dc-isd-show__glow {
    position: absolute; z-index: 0; pointer-events: none;
    top: -140px; left: 50%; transform: translateX(-50%);
    width: 760px; height: 420px; border-radius: 50%;
    background: radial-gradient(circle, rgba(58,160,255,0.16), transparent 68%);
    filter: blur(46px);
  }
  .dc-isd-show__container {
    position: relative; z-index: 1;
    max-width: 1320px; margin: 0 auto; padding-inline: 28px;
  }
  .dc-isd-show__head { text-align: center; max-width: 720px; margin: 0 auto 44px; }
  .dc-isd-show__eyebrow {
    display: inline-block; font-size: 12.5px; font-weight: 700;
    letter-spacing: 0.16em; text-transform: uppercase; color: #6ea8e6; margin-bottom: 14px;
  }
  .dc-isd-show__title {
    font-family: "Bricolage Grotesque", "Manrope", sans-serif;
    font-weight: 800; font-size: clamp(28px, 4vw, 46px);
    line-height: 1.05; letter-spacing: -0.03em; color: #fff; margin: 0 0 14px;
  }
  .dc-isd-show__sub { font-size: 16px; color: #aab6c4; line-height: 1.55; margin: 0; }

  .dc-isd-show__grid {
    display: grid; gap: 22px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .dc-isd-show__grid--2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .dc-isd-show__grid--4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  @media (max-width: 1080px) { .dc-isd-show__grid, .dc-isd-show__grid--4 { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 620px) { .dc-isd-show__grid, .dc-isd-show__grid--2, .dc-isd-show__grid--4 { grid-template-columns: 1fr; } }
  .dc-isd-show__empty { grid-column: 1 / -1; text-align: center; color: #93a1b2; font-size: 14.5px; padding: 40px 0; }

  /* ---------- Card (estilizado aqui, markup no snippet dc-isd-card) ---------- */
  .dc-isd-card {
    display: flex; flex-direction: column;
    background: linear-gradient(180deg, rgba(255,255,255,0.045), rgba(255,255,255,0.02));
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 22px; overflow: hidden;
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.3s ease;
    position: relative;
  }
  .dc-isd-card::before {
    content: ""; position: absolute; inset: 0; border-radius: 22px; padding: 1px;
    background: linear-gradient(140deg, rgba(58,160,255,0.6), transparent 40%);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor; mask-composite: exclude;
    opacity: 0; transition: opacity 0.3s ease; pointer-events: none;
  }
  .dc-isd-card:hover {
    transform: translateY(-4px);
    border-color: rgba(58,160,255,0.35);
    box-shadow: 0 26px 60px -30px rgba(58,160,255,0.55);
  }
  .dc-isd-card:hover::before { opacity: 1; }

  .dc-isd-card__media {
    position: relative; display: block;
    aspect-ratio: 4 / 3;
    background: radial-gradient(120% 120% at 50% 0%, #f4f6f9 0%, #e7ebf1 100%);
    overflow: hidden;
  }
  .dc-isd-card__img {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: contain; padding: 22px;
    transition: transform 0.4s ease;
  }
  .dc-isd-card__img--ph { object-fit: cover; padding: 0; }
  .dc-isd-card:hover .dc-isd-card__img { transform: scale(1.05); }
  .dc-isd-card__sheen {
    position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(105deg, transparent 40%, rgba(255,255,255,0.45) 50%, transparent 60%);
    transform: translateX(-120%); transition: transform 0.7s ease;
  }
  .dc-isd-card:hover .dc-isd-card__sheen { transform: translateX(120%); }
  .dc-isd-card__badge {
    position: absolute; top: 12px; left: 12px; z-index: 2;
    background: #0d1115; color: #fff; font-size: 11px; font-weight: 700;
    letter-spacing: 0.04em; padding: 5px 10px; border-radius: 999px;
  }

  .dc-isd-card__body { display: flex; flex-direction: column; flex: 1; padding: 20px 20px 22px; }
  .dc-isd-card__eyebrow {
    font-size: 11.5px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase;
    color: #6ea8e6; margin-bottom: 7px;
  }
  .dc-isd-card__title {
    font-family: "Bricolage Grotesque", "Manrope", sans-serif;
    font-size: 20px; font-weight: 700; line-height: 1.2; letter-spacing: -0.02em; margin: 0 0 12px;
  }
  .dc-isd-card__title a { color: #fff; text-decoration: none; }
  .dc-isd-card__title a:hover { color: #6ea8e6; }
  .dc-isd-card__specs { list-style: none; margin: 0 0 16px; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .dc-isd-card__specs li { display: flex; align-items: center; gap: 9px; font-size: 13.5px; color: #b6c1cf; }
  .dc-isd-card__specs svg { color: #2ec4b6; flex-shrink: 0; }

  .dc-isd-card__price-row { display: flex; align-items: baseline; gap: 10px; margin: auto 0 16px; padding-top: 4px; }
  .dc-isd-card__price {
    font-family: "Bricolage Grotesque", "Manrope", sans-serif;
    font-size: 26px; font-weight: 800; color: #fff; letter-spacing: -0.02em;
  }
  .dc-isd-card__price-old { font-size: 14px; color: #7d8a99; text-decoration: line-through; }

  .dc-isd-card__actions { display: flex; flex-direction: column; gap: 10px; }
  .dc-isd-card__form { margin: 0; }
  .dc-isd-card__cta {
    width: 100%; height: 48px; border: 0; border-radius: 999px; cursor: pointer;
    background: linear-gradient(180deg, #3aa0ff, #1f7ae0); color: #04121f;
    font-family: inherit; font-size: 14.5px; font-weight: 700;
    display: inline-flex; align-items: center; justify-content: center; gap: 9px;
    transition: transform 0.16s ease, box-shadow 0.25s ease, filter 0.2s ease;
  }
  .dc-isd-card__cta:hover { box-shadow: 0 14px 30px -12px rgba(58,160,255,0.75); transform: translateY(-1px); }
  .dc-isd-card__cta:active { transform: translateY(1px); }
  .dc-isd-card__cta[disabled] { background: rgba(255,255,255,0.12); color: #8794a3; cursor: not-allowed; box-shadow: none; }
  .dc-isd-card__cta.is-added { background: #2ec4b6; color: #04121f; }
  .dc-isd-card__detail {
    display: inline-flex; align-items: center; justify-content: center; gap: 7px;
    font-size: 13px; font-weight: 600; color: #aab6c4; text-decoration: none;
    transition: color 0.15s ease, gap 0.15s ease;
  }
  .dc-isd-card__detail:hover { color: #fff; gap: 11px; }

  .dc-isd-show__foot { text-align: center; margin-top: 40px; }
  .dc-isd-show__foot-btn {
    display: inline-flex; align-items: center; gap: 9px;
    height: 52px; padding: 0 28px; border-radius: 999px;
    border: 1px solid rgba(255,255,255,0.18); background: rgba(255,255,255,0.05);
    color: #eef2f7; font-weight: 700; font-size: 15px; text-decoration: none;
    transition: background 0.2s ease, transform 0.18s ease;
  }
  .dc-isd-show__foot-btn:hover { background: rgba(255,255,255,0.12); transform: translateY(-2px); }
  @media (prefers-reduced-motion: reduce) {
    .dc-isd-card, .dc-isd-card__img, .dc-isd-card__sheen { transition: none; }
  }
{% endstylesheet %}

{%- comment -%} Add-to-carrinho é tratado globalmente por assets/dc-product-card.js
   (botão [data-dc-add data-variant-id]), igual aos outros cards do tema. {%- endcomment -%}

{% schema %}
{
  "name": "DC ISD Showcase",
  "tag": "section",
  "class": "section-dc-isd-showcase",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Câmeras para videoconferência" },
    { "type": "text", "id": "heading", "label": "Título", "default": "A câmera ideal para cada sala." },
    { "type": "textarea", "id": "subheading", "label": "Subtítulo", "default": "Da huddle room ao auditório — captação 4K profissional, plug-and-play." },
    { "type": "select", "id": "columns", "label": "Colunas (desktop)", "default": "3", "options": [
      { "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" }
    ] },
    { "type": "text", "id": "cta_label", "label": "Texto do botão de compra", "default": "Adicionar ao carrinho" },
    { "type": "header", "content": "Fallback (quando não há blocos)" },
    { "type": "collection", "id": "collection", "label": "Coleção", "info": "Usada só se você não adicionar blocos de Produto abaixo." },
    { "type": "text", "id": "collection_handle", "label": "…ou handle da coleção", "default": "automacao" },
    { "type": "range", "id": "max_products", "label": "Máx. produtos (fallback)", "min": 3, "max": 12, "step": 1, "default": 6 },
    { "type": "header", "content": "Botão no rodapé (opcional)" },
    { "type": "text", "id": "foot_cta_label", "label": "Texto", "default": "Ver toda a linha de automação" },
    { "type": "url", "id": "foot_cta_link", "label": "Link" },
    { "type": "header", "content": "Âncora & espaçamento" },
    { "type": "text", "id": "anchor_id", "label": "ID de âncora", "default": "isd-produtos" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 40, "max": 200, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 40, "max": 200, "step": 4, "unit": "px", "default": 88 }
  ],
  "blocks": [
    {
      "type": "produto",
      "name": "Produto",
      "settings": [
        { "type": "product", "id": "product", "label": "Produto" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow (ex: Compacta 4K)" },
        { "type": "text", "id": "title", "label": "Título curto (opcional)", "info": "Vazio = usa o nome do produto." },
        { "type": "text", "id": "spec1", "label": "Destaque 1 (✓)" },
        { "type": "text", "id": "spec2", "label": "Destaque 2 (✓)" },
        { "type": "text", "id": "spec3", "label": "Destaque 3 (✓)" },
        { "type": "text", "id": "badge", "label": "Selo (ex: Mais vendido)" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    { "name": "DC ISD Showcase" }
  ]
}
{% endschema %}
