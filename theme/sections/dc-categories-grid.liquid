<section class="dc-categories section section--page-width spacing-style" style="{% render 'spacing-padding', settings: section.settings %}">
  <div class="dc-categories__head">
    <div>
      <p class="dc-categories__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h2 class="dc-categories__title">{{ section.settings.heading | escape }}</h2>
    </div>
    {%- if section.settings.cta_label != blank -%}
      <a href="{{ section.settings.cta_link | default: '#' }}" class="dc-categories__cta-all">
        {{ section.settings.cta_label | escape }}
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14"/><path d="m13 5 7 7-7 7"/></svg>
      </a>
    {%- endif -%}
  </div>

  <div class="dc-categories__grid" data-dc-cat3d id="dc-cat3d-{{ section.id }}">
    {%- for block in section.blocks -%}
      {%- if block.type == 'category' -%}
        <a href="{{ block.settings.link | default: '#' }}" class="dc-cat"
          {% if block.settings.cat3d_key != blank and block.settings.cat3d_key != 'none' %}data-cat3d-key="{{ block.settings.cat3d_key }}"{% endif %}
          {{ block.shopify_attributes }}>
          <div class="dc-cat__art" data-cat3d-art>
            {%- if block.settings.icon_svg != blank -%}
              {{ block.settings.icon_svg }}
            {%- else -%}
              <svg viewBox="0 0 160 140" width="100%" height="100%" aria-hidden="true">
                <ellipse cx="80" cy="124" rx="56" ry="6" fill="rgba(13,17,21,0.10)"/>
                <rect x="34" y="36" width="92" height="64" rx="6" fill="#2a3038"/>
                <rect x="44" y="58" width="40" height="34" rx="2" fill="#0e8aa5"/>
              </svg>
            {%- endif -%}
          </div>
          <div class="dc-cat__name">{{ block.settings.name | escape }}</div>
          {%- if block.settings.collection != blank -%}
            <div class="dc-cat__count">{{ block.settings.collection.products_count }} {% if block.settings.collection.products_count == 1 %}produto{% else %}produtos{% endif %}</div>
          {%- elsif block.settings.count != blank -%}
            <div class="dc-cat__count">{{ block.settings.count | escape }}</div>
          {%- endif -%}
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{%- comment -%}
  Ícones 3D: um único canvas WebGL cobre a grid inteira e desenha cada modelo
  na região do seu card (scissor). O bundle (~148 KB gzip) só é buscado quando
  a grid chega perto da viewport, então não entra no caminho do LCP. Sem WebGL
  ou sem chave de modelo no bloco, o SVG chapado continua sendo o ícone.
{%- endcomment -%}
<script>
  (function () {
    var root = document.getElementById('dc-cat3d-{{ section.id }}');
    if (!root || !root.querySelector('[data-cat3d-key]')) return;
    if (!window.WebGLRenderingContext || !window.IntersectionObserver) return;
    var load = function () {
      if (window.__dcCat3dLoaded) return;
      window.__dcCat3dLoaded = true;
      var s = document.createElement('script');
      s.src = {{ 'dc-cat-3d.js' | asset_url | json }};
      s.defer = true;
      document.head.appendChild(s);
    };
    var io = new IntersectionObserver(function (entries) {
      if (!entries[0].isIntersecting) return;
      io.disconnect();
      load();
    }, { rootMargin: '400px' });
    io.observe(root);
  })();
</script>

{% stylesheet %}
  .dc-categories__grid { position: relative; }
  .dc-cat3d__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 2;
  }
  /* com o 3D ativo o SVG chapado sai de cena, e o zoom do hover passa a ser
     feito pela câmera (a caixa da arte fica parada para o scissor não borrar) */
  .dc-cat3d-on .dc-cat[data-cat3d-key] .dc-cat__art > svg { visibility: hidden; }
  .dc-cat3d-on .dc-cat[data-cat3d-key]:hover .dc-cat__art { transform: none; }
  .dc-categories { padding-block: 56px; }
  .dc-categories__head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 28px;
  }
  .dc-categories__eyebrow {
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #6b7280;
    font-weight: 600;
    margin: 0 0 10px;
  }
  .dc-categories__title {
    font-family: "Bricolage Grotesque", "Manrope", sans-serif;
    font-size: 44px;
    line-height: 1.04;
    letter-spacing: -0.02em;
    font-weight: 700;
    margin: 0;
    color: #0d1115;
  }
  .dc-categories__cta-all {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 40px;
    padding: 0 18px;
    border-radius: 999px;
    border: 1px solid #d9dade;
    color: #0d1115;
    font-weight: 600;
    font-size: 13.5px;
    text-decoration: none;
    transition: all 0.15s;
  }
  .dc-categories__cta-all:hover { border-color: #0d1115; background: #0d1115; color: #fff; }
  .dc-categories__grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 8px;
  }
  .dc-cat {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 22px;
    padding: 20px 12px 22px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    text-align: center;
    transition: transform 0.22s, background 0.22s, border-color 0.22s, box-shadow 0.22s;
    cursor: pointer;
    color: #0d1115;
    text-decoration: none;
    /* sem isto o item de grid herda min-width:auto e a arte de 130px empurra
       a grid para além da largura da página no mobile */
    min-width: 0;
  }
  .dc-cat:hover {
    transform: translateY(-3px);
    background: #fff;
    border-color: #ececef;
    box-shadow: 0 16px 36px -18px rgba(13, 17, 21, 0.18);
  }
  .dc-cat__art {
    width: 100%;
    max-width: 130px;
    aspect-ratio: 13 / 11;
    margin-bottom: 6px;
    display: grid;
    place-items: center;
    transition: transform 0.3s ease;
  }
  .dc-cat:hover .dc-cat__art { transform: translateY(-2px) scale(1.04); }
  .dc-cat__name {
    font-weight: 600;
    font-size: 14px;
    color: #0d1115;
    letter-spacing: -0.01em;
    margin-top: 4px;
  }
  .dc-cat__count {
    font-size: 12px;
    color: #6b7280;
  }
  @media (max-width: 1100px) { .dc-categories__grid { grid-template-columns: repeat(4, 1fr); } }
  @media (max-width: 700px) {
    .dc-categories__grid { grid-template-columns: repeat(3, 1fr); }
    .dc-categories__title { font-size: 30px; }
  }
{% endstylesheet %}

