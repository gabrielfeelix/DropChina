{%- comment -%}
  DC ISD Hero — hero futurista/tech para a página de Automação (DNA ISD Tech).
  Fundo escuro com grid animado + glows azuis. Tudo editável no Editor de Tema.
{%- endcomment -%}

{%- liquid
  assign show_logo = section.settings.show_logo
  assign bg = section.settings.bg_image
-%}

<section
  class="dc-isd-hero{% if bg != blank %} dc-isd-hero--has-bg{% endif %}"
  style="padding-block: {{ section.settings.padding_top | default: 96 }}px {{ section.settings.padding_bottom | default: 96 }}px;"
  id="{{ section.settings.anchor_id | default: 'isd-topo' | escape }}"
>
  {%- if bg != blank -%}
    {{ bg | image_url: width: 2400 | image_tag:
        loading: 'eager',
        class: 'dc-isd-hero__bgimg',
        alt: '',
        widths: '900, 1400, 2000, 2400',
        sizes: '100vw' }}
  {%- endif -%}
  <span class="dc-isd-hero__grid" aria-hidden="true"></span>
  <span class="dc-isd-hero__glow dc-isd-hero__glow--a" aria-hidden="true"></span>
  <span class="dc-isd-hero__glow dc-isd-hero__glow--b" aria-hidden="true"></span>

  <div class="dc-isd-hero__inner">
    {%- if show_logo -%}
      <div class="dc-isd-hero__brand">
        <img src="{{ 'isd-tech-logo-white.png' | asset_url }}" alt="ISD Tech" class="dc-isd-hero__logo" width="112" height="52" loading="eager">
        <span class="dc-isd-hero__brand-note">{{ section.settings.brand_note | default: 'Distribuidor oficial no Brasil' | escape }}</span>
      </div>
    {%- endif -%}

    {%- if section.settings.eyebrow != blank -%}
      <span class="dc-isd-hero__eyebrow">
        <span class="dc-isd-hero__dot" aria-hidden="true"></span>{{ section.settings.eyebrow | escape }}
      </span>
    {%- endif -%}

    <h1 class="dc-isd-hero__title">{{ section.settings.heading | default: 'Automação que trabalha por você.' }}</h1>

    {%- if section.settings.subheading != blank -%}
      <p class="dc-isd-hero__sub">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}

    <div class="dc-isd-hero__actions">
      {%- if section.settings.cta1_label != blank -%}
        <a href="{{ section.settings.cta1_link | default: '#isd-produtos' }}" class="dc-isd-hero__btn dc-isd-hero__btn--primary">
          {{ section.settings.cta1_label | escape }}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14"/><path d="m5 12 7 7 7-7"/></svg>
        </a>
      {%- endif -%}
      {%- if section.settings.cta2_label != blank -%}
        <a href="{{ section.settings.cta2_link | default: '#' }}" class="dc-isd-hero__btn dc-isd-hero__btn--ghost"{% if section.settings.cta2_link contains 'wa.me' or section.settings.cta2_link contains 'whatsapp' %} target="_blank" rel="noopener"{% endif %}>
          {{ section.settings.cta2_label | escape }}
        </a>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <ul class="dc-isd-hero__stats">
        {%- for block in section.blocks -%}
          {%- if block.type == 'stat' -%}
            <li class="dc-isd-hero__stat" {{ block.shopify_attributes }}>
              <b>{{ block.settings.value | escape }}</b>
              <span>{{ block.settings.label | escape }}</span>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .dc-isd-hero {
    position: relative;
    overflow: hidden;
    background: radial-gradient(120% 120% at 50% -10%, #10161f 0%, #0a0e14 45%, #070a0e 100%);
    color: #eef2f7;
    isolation: isolate;
  }
  .dc-isd-hero__bgimg {
    position: absolute; inset: 0; z-index: 0;
    width: 100%; height: 100%; object-fit: cover;
    opacity: 0.28;
  }
  .dc-isd-hero--has-bg::after {
    content: ""; position: absolute; inset: 0; z-index: 0;
    background: linear-gradient(180deg, rgba(7,10,14,0.75), rgba(7,10,14,0.92));
  }
  /* grid futurista */
  .dc-isd-hero__grid {
    position: absolute; inset: -2px; z-index: 0;
    background-image:
      linear-gradient(to right, rgba(110,168,230,0.10) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(110,168,230,0.10) 1px, transparent 1px);
    background-size: 54px 54px;
    -webkit-mask-image: radial-gradient(120% 90% at 50% 0%, #000 30%, transparent 78%);
    mask-image: radial-gradient(120% 90% at 50% 0%, #000 30%, transparent 78%);
  }
  /* glows estáticos: renderizam uma vez, sem repaint por frame (zero lag) */
  .dc-isd-hero__glow {
    position: absolute; z-index: 0; border-radius: 50%;
    filter: blur(52px); opacity: 0.5; pointer-events: none;
  }
  .dc-isd-hero__glow--a {
    width: 420px; height: 420px; top: -160px; left: -80px;
    background: radial-gradient(circle, rgba(58,160,255,0.5), transparent 70%);
  }
  .dc-isd-hero__glow--b {
    width: 340px; height: 340px; bottom: -180px; right: -60px;
    background: radial-gradient(circle, rgba(46,196,182,0.38), transparent 70%);
  }

  .dc-isd-hero__inner {
    position: relative; z-index: 2;
    max-width: 1000px;
    margin: 0 auto;
    padding-inline: 28px;
    text-align: center;
  }
  .dc-isd-hero__brand {
    display: inline-flex; align-items: center; gap: 12px;
    padding: 8px 16px 8px 12px;
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 999px;
    background: rgba(255,255,255,0.04);
    margin-bottom: 26px;
    backdrop-filter: blur(6px);
  }
  .dc-isd-hero__logo { height: 26px; width: auto; display: block; }
  .dc-isd-hero__brand-note {
    font-size: 12px; color: #aeb9c6; letter-spacing: 0.02em;
    border-left: 1px solid rgba(255,255,255,0.14); padding-left: 12px;
  }
  .dc-isd-hero__eyebrow {
    display: inline-flex; align-items: center; gap: 8px;
    font-size: 12.5px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase;
    color: #6ea8e6; margin-bottom: 18px;
  }
  .dc-isd-hero__dot {
    width: 7px; height: 7px; border-radius: 50%; background: #3aa0ff;
    box-shadow: 0 0 0 0 rgba(58,160,255,0.7); animation: dc-isd-pulse 2.4s infinite;
  }
  @keyframes dc-isd-pulse {
    0% { box-shadow: 0 0 0 0 rgba(58,160,255,0.55); }
    70% { box-shadow: 0 0 0 10px rgba(58,160,255,0); }
    100% { box-shadow: 0 0 0 0 rgba(58,160,255,0); }
  }
  .dc-isd-hero__title {
    font-family: "Bricolage Grotesque", "Manrope", sans-serif;
    font-weight: 800;
    font-size: clamp(34px, 6vw, 66px);
    line-height: 1.03;
    letter-spacing: -0.03em;
    margin: 0 0 20px;
    background: linear-gradient(180deg, #ffffff 0%, #c9d4e0 100%);
    -webkit-background-clip: text; background-clip: text;
    -webkit-text-fill-color: transparent; color: #fff;
  }
  .dc-isd-hero__sub {
    font-size: clamp(15px, 2vw, 18px);
    color: #b6c1cf;
    line-height: 1.6;
    max-width: 62ch;
    margin: 0 auto 30px;
  }
  .dc-isd-hero__actions {
    display: flex; flex-wrap: wrap; gap: 14px; justify-content: center;
  }
  .dc-isd-hero__btn {
    display: inline-flex; align-items: center; gap: 9px;
    height: 54px; padding: 0 28px;
    border-radius: 999px;
    font-weight: 700; font-size: 15px; text-decoration: none;
    transition: transform 0.18s ease, box-shadow 0.25s ease, background 0.2s ease;
  }
  .dc-isd-hero__btn--primary {
    background: linear-gradient(180deg, #3aa0ff, #1f7ae0);
    color: #04121f;
    box-shadow: 0 12px 34px -12px rgba(58,160,255,0.7);
  }
  .dc-isd-hero__btn--primary:hover { transform: translateY(-2px); box-shadow: 0 18px 40px -12px rgba(58,160,255,0.85); }
  .dc-isd-hero__btn--primary svg { animation: dc-isd-bounce 2.2s ease-in-out infinite; }
  @keyframes dc-isd-bounce { 0%,100% { transform: translateY(0); } 50% { transform: translateY(3px); } }
  .dc-isd-hero__btn--ghost {
    background: rgba(255,255,255,0.06);
    color: #eef2f7;
    border: 1px solid rgba(255,255,255,0.16);
  }
  .dc-isd-hero__btn--ghost:hover { background: rgba(255,255,255,0.12); transform: translateY(-2px); }

  .dc-isd-hero__stats {
    list-style: none; margin: 44px auto 0; padding: 0;
    display: flex; flex-wrap: wrap; justify-content: center; gap: 14px 44px;
  }
  .dc-isd-hero__stat { display: flex; flex-direction: column; gap: 3px; }
  .dc-isd-hero__stat b {
    font-family: "Bricolage Grotesque", "Manrope", sans-serif;
    font-size: 30px; font-weight: 800; color: #fff; letter-spacing: -0.02em; line-height: 1;
  }
  .dc-isd-hero__stat span { font-size: 12.5px; color: #93a1b2; letter-spacing: 0.04em; text-transform: uppercase; }

  @media (max-width: 600px) {
    .dc-isd-hero__brand { flex-wrap: wrap; justify-content: center; }
    .dc-isd-hero__btn { width: 100%; justify-content: center; }
    .dc-isd-hero__stats { gap: 18px 30px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .dc-isd-hero__grid, .dc-isd-hero__glow, .dc-isd-hero__dot, .dc-isd-hero__btn--primary svg { animation: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "DC ISD Hero",
  "tag": "section",
  "class": "section-dc-isd-hero",
  "settings": [
    { "type": "checkbox", "id": "show_logo", "label": "Mostrar selo ISD Tech", "default": true },
    { "type": "text", "id": "brand_note", "label": "Texto ao lado do logo", "default": "Distribuidor oficial no Brasil" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Automação & Tecnologia ISD" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Automação que trabalha por você." },
    { "type": "textarea", "id": "subheading", "label": "Subtítulo", "default": "Câmeras de videoconferência 4K, totens de autoatendimento, telas interativas e digital signage. Equipamentos profissionais plug-and-play, com garantia oficial." },
    { "type": "text", "id": "cta1_label", "label": "Botão 1 — texto", "default": "Ver equipamentos" },
    { "type": "url", "id": "cta1_link", "label": "Botão 1 — link", "info": "Deixe #isd-produtos para rolar até os produtos." },
    { "type": "text", "id": "cta2_label", "label": "Botão 2 — texto", "default": "Falar com especialista" },
    { "type": "url", "id": "cta2_link", "label": "Botão 2 — link" },
    { "type": "image_picker", "id": "bg_image", "label": "Imagem de fundo (opcional)", "info": "Fica escurecida atrás do conteúdo. Ideal 2400x1200." },
    { "type": "text", "id": "anchor_id", "label": "ID de âncora da seção", "default": "isd-topo" },
    { "type": "header", "content": "Espaçamento" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 40, "max": 200, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 40, "max": 200, "step": 4, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Número de destaque",
      "settings": [
        { "type": "text", "id": "value", "label": "Valor", "default": "4K UHD" },
        { "type": "text", "id": "label", "label": "Rótulo", "default": "Qualidade de imagem" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "DC ISD Hero",
      "blocks": [
        { "type": "stat", "settings": { "value": "4K UHD", "label": "Qualidade de imagem" } },
        { "type": "stat", "settings": { "value": "Plug & Play", "label": "Instalação simples" } },
        { "type": "stat", "settings": { "value": "12 meses", "label": "Garantia oficial" } }
      ]
    }
  ]
}
{% endschema %}
