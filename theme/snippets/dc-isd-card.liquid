{%- comment -%}
  DC ISD Card — card de produto para a vitrine de Automação (DNA ISD).
  Params:
    product           (obrigatório) objeto product
    eyebrow           (opcional) rótulo azul acima do título (ex: "Compacta 4K")
    title             (opcional) título curto; default = product.title
    spec1/spec2/spec3 (opcional) linhas de destaque com ✓
    badge             (opcional) selo no canto da imagem (ex: "Mais vendido")
    cta_label         (opcional) texto do botão; default "Adicionar ao carrinho"
    shopify_attributes(opcional) atributos do bloco (Editor de Tema)
{%- endcomment -%}

{%- liquid
  assign card_title = title | default: product.title
  assign v = product.selected_or_first_available_variant
  assign has_specs = false
  if spec1 != blank or spec2 != blank or spec3 != blank
    assign has_specs = true
  endif
  assign on_sale = false
  if v.compare_at_price > v.price
    assign on_sale = true
  endif
-%}

<article class="dc-isd-card" {{ shopify_attributes }}>
  <a class="dc-isd-card__media" href="{{ product.url }}" aria-label="{{ card_title | escape }}">
    {%- if badge != blank -%}<span class="dc-isd-card__badge">{{ badge | escape }}</span>{%- endif -%}
    {%- if product.featured_image -%}
      {{ product.featured_image | image_url: width: 640 | image_tag:
          loading: 'lazy',
          class: 'dc-isd-card__img',
          alt: product.featured_image.alt | default: card_title,
          widths: '320, 480, 640',
          sizes: '(max-width: 760px) 90vw, 380px' }}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'dc-isd-card__img dc-isd-card__img--ph' }}
    {%- endif -%}
    <span class="dc-isd-card__sheen" aria-hidden="true"></span>
  </a>

  <div class="dc-isd-card__body">
    {%- if eyebrow != blank -%}<span class="dc-isd-card__eyebrow">{{ eyebrow | escape }}</span>{%- endif -%}
    <h3 class="dc-isd-card__title"><a href="{{ product.url }}">{{ card_title | escape }}</a></h3>

    {%- if has_specs -%}
      <ul class="dc-isd-card__specs">
        {%- assign specs = spec1 | append: '|' | append: spec2 | append: '|' | append: spec3 | split: '|' -%}
        {%- for s in specs -%}
          {%- assign sc = s | strip -%}
          {%- if sc != blank -%}
            <li>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
              {{ sc | escape }}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if v != blank and v.price != blank -%}
      <div class="dc-isd-card__price-row">
        {%- if on_sale -%}<span class="dc-isd-card__price-old">{{ v.compare_at_price | money }}</span>{%- endif -%}
        <span class="dc-isd-card__price">{{ v.price | money }}</span>
      </div>
    {%- endif -%}

    <div class="dc-isd-card__actions">
      {%- if v != blank -%}
        <button type="button" class="dc-isd-card__cta" data-dc-add data-variant-id="{{ v.id }}"{% unless v.available %} disabled{% endunless %}>
          {%- if v.available -%}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 4h2l2.5 12.5a2 2 0 0 0 2 1.5h8a2 2 0 0 0 2-1.5L21 8H6"/><circle cx="10" cy="21" r="1.4"/><circle cx="17" cy="21" r="1.4"/></svg>
            <span>{{ cta_label | default: 'Adicionar ao carrinho' | escape }}</span>
          {%- else -%}
            Indisponível
          {%- endif -%}
        </button>
      {%- endif -%}
      <a href="{{ product.url }}" class="dc-isd-card__detail">Ver detalhes
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14"/><path d="m13 5 7 7-7 7"/></svg>
      </a>
    </div>
  </div>
</article>
